{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RestroPulse: run in terminal (hot reload)",
      "type": "process",
      "command": "${workspaceFolder}/.fvm/versions/3.38.6/bin/flutter",
      "args": ["run", "--debug", "-t", "lib/main.dart"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
